{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start Backend Server (Port 5000)",
      "type": "shell",
      "command": "node server.js",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "group": "interviewiq",
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "2. Start Frontend UI (Port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "interviewiq",
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Full InterviewIQ App (Backend + Frontend)",
      "dependsOn": [
        "1. Start Backend Server (Port 5000)",
        "2. Start Frontend UI (Port 5173)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
